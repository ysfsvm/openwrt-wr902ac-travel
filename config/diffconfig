# TP-Link TL-WR902AC v3: low-memory travel router configuration.
# Appended to an empty .config, expanded with "make defconfig".

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tplink_tl-wr902ac-v3=y

# squashfs: small_flash forces 1024 KiB blocks.  128 KiB costs about
# 205 KB of flash and saves about 3.5 MiB of RAM (SUnreclaim -3.6 MiB,
# vmalloc -0.9 MiB measured).
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=128

# Kernel swap support stays (small_flash disables it), but no zram: the CPU
# is at about 90% at 100 Mbit/s and swap cannot hold kernel or Wi-Fi memory.
CONFIG_KERNEL_SWAP=y
# CONFIG_PACKAGE_kmod-zram is not set
# CONFIG_PACKAGE_zram-swap is not set

# Full wpad (SAE, 802.11k/v, WPA-Enterprise), mbedtls; no 802.11s.
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_MAC80211_MESH is not set
CONFIG_PACKAGE_iw=y

# 5 GHz: the driver is in the image; the radio can be disabled in UCI.
CONFIG_PACKAGE_kmod-mt76x0e=y

# LuCI without the package manager, over HTTPS (px5g-mbedtls, EC P-256
# self-signed).  Not the luci or luci-ssl meta packages: they pull in
# luci-app-package-manager.
CONFIG_PACKAGE_luci-light=y
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-ssl is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
CONFIG_PACKAGE_px5g-mbedtls=y

# No package manager: images only.
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_apk-openssl is not set

# No IPv6 userspace.  Kernel IPv6 stays: fw4 needs it.
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_odhcp6c is not set

# urngd is not needed with kernel 6.12.
# CONFIG_PACKAGE_urngd is not set

# No statistics (collectd measured at 2.0 MiB).
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_collectd is not set

# USB tethering: RNDIS, CDC Ethernet and CDC-NCM (newer Android phones).
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

# Mode switch: button events per position, profiles and the LuCI page
# (feed/).
CONFIG_PACKAGE_slide-switch=y
CONFIG_PACKAGE_modeswitch=y
CONFIG_PACKAGE_luci-app-modeswitch=y
