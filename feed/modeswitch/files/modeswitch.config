
# Positions are the slide-switch names (TP-Link factory labels in 'label');
# 'alias' is the name used in LuCI, logs and modectl. Section order is the
# physical order on the device: Share ETH | Mobile Hotspot (middle) | AP.

config modeswitch 'main'
	# 1 = moving the hardware switch (and booting) applies that position
	option enabled '1'
	# config files owned by the positions; everything else is global
	list files 'network'
	list files 'wireless'
	list files 'firewall'
	list files 'dhcp'
	# inputs of the defaults templates (only used when a profile is built)
	option lan_ip '192.168.50.1/24'

config position 'share_eth'
	option name 'share-eth'
	option alias 'Home'
	option label 'Share ETH'
	option description 'Access point on a VLAN trunk: the wired port carries the home, management, IoT and guest VLANs tagged; the 2.4 GHz SSIDs are bridged to their VLANs. Routing and DHCP are upstream.'
	# Inputs of the defaults template, used only when this profile is built
	# (first use or Reset).  Set the Wi-Fi keys before that:
	#   uci set modeswitch.share_eth.home_key='...'
	#   uci set modeswitch.share_eth.guest_key='...'
	# Optional: wifi_country (ISO 3166 code; default: keep the radio's).
	option mgmt_ip '192.168.20.2/24'
	option mgmt_gw '192.168.20.1'
	option mgmt_dns '192.168.20.1'
	option vlan_home '10'
	option vlan_mgmt '20'
	option vlan_iot '30'
	option vlan_guest '40'
	option home_ssid 'OpenWrt'
	option guest_ssid 'OpenWrt-Guest'
	option wifi_channel 'auto'
	option wifi_htmode 'HT40'

config position 'share_hotspot'
	option name 'share-hotspot'
	option alias 'AP'
	option label 'Mobile Hotspot'
	option description 'Travel router: Wi-Fi AP with its own LAN 192.168.50.1/24 and DHCP. Uplink is the wired port, or a Wi-Fi joined in LuCI (Scan, Join), in which case the wired port is LAN. NAT; captive-portal friendly (DNS rebind protection off).'
	option wired_role 'auto'

config position 'ap'
	option name 'ap'
	option alias 'RNDIS'
	option label 'AP'
	option description 'USB tethering: Android phone on USB (RNDIS or CDC-NCM, usb0) is the uplink, shared to Wi-Fi and the wired port.'
